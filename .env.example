# ============================================================================
# LLM provider
# ============================================================================
# This RAG app's prompts, schemas, and eval set were designed against
# Anthropic Claude. **Leave LLM_PROVIDER=anthropic unless you are explicitly
# running an A/B evaluation against an alternative.** Other providers are
# wired up but UNVALIDATED — protocol JSON parse rate, the chat planner's
# [CHOICES] markup, and grounding-rule adherence may all regress.
LLM_PROVIDER=anthropic

# Model identifier passed to the underlying API. Falls back to CLAUDE_MODEL
# below when unset (backward compatibility for existing deploys).
LLM_MODEL=claude-sonnet-4-20250514

# ----- Required for the default provider -----
ANTHROPIC_API_KEY=sk-ant-...

# ----- EXPERIMENTAL providers (not yet validated) ---------------------------
# Only fill these in if you're running an evaluation against a non-default
# provider. See backend/app/core/llm/__init__.py for the full caveat.
#   openai:   gpt-4o, gpt-4o-mini, o1-...
#   deepseek: deepseek-chat, deepseek-reasoner
#   kimi:     moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=          # for the kimi provider
# Optional: override Moonshot's regional endpoint (default: api.moonshot.ai)
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ============================================================================
# Retrieval
# ============================================================================
VOYAGE_API_KEY=                        # omit to fall back to TF-IDF
RETRIEVER_TYPE=voyage                  # voyage | tfidf
CSV_PATH=/app/data/Breast_Cancer-RECRUITING-phase2-625.csv

# ============================================================================
# Supabase (persistent feedback storage for Cloud Run)
# ============================================================================
# When set, feedback and drug aliases are stored in Supabase instead of
# local files. Omit both to fall back to on-disk JSONL (fine for local dev).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# GCS (data storage, decoupled from Docker image)
# ============================================================================
# Set DATA_SOURCE=gcs to pull trial CSV + embeddings cache from GCS at
# startup instead of reading baked-in files. Leave as "local" for local dev.
DATA_SOURCE=local
GCS_BUCKET=
GCS_CSV_BLOB=data/breast_cancer_trials.csv
GCS_EMBEDDINGS_PREFIX=data/embeddings_cache/

# ============================================================================
# Misc
# ============================================================================
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Backward-compat: still read by the factory if LLM_MODEL is unset.
CLAUDE_MODEL=claude-sonnet-4-20250514
